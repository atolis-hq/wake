{
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["src-next/main.ts", "src-next/*/index.ts", "test-next/**/*.test.ts"],
      "project": ["src-next/**/*.ts", "!src-next/surfaces/web/**", "test-next/**/*.ts"]
    },
    "src-next/surfaces/web": {
      "entry": ["e2e/*.spec.ts", "e2e/surface-fixture.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "e2e/**/*.ts", "*.config.ts"]
    }
  }
}
