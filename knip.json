{
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@atolis-hq/eventing", "@atolis-hq/eventing-filesystem"],
      "entry": [
        "src/*/index.ts",
        "test/**/*.test.ts",
        "test/integration/surfaces/fixtures/wait-forever-fixture.ts"
      ],
      "project": ["src/**/*.ts", "!src/surfaces/web/**", "test/**/*.ts"]
    },
    "packages/eventing": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/eventing-filesystem": {
      "entry": ["test/**/*.test.ts", "test/file-lock-contender.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "src/surfaces/web": {
      "entry": ["e2e/*.spec.ts", "e2e/surface-fixture.ts"],
      "project": ["src/**/*.{js,ts,tsx}", "test/**/*.{ts,tsx}", "e2e/**/*.ts", "*.config.ts"]
    }
  }
}
