{
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["src/*/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "!src/surfaces/web/**", "test/**/*.ts"]
    },
    "src/surfaces/web": {
      "entry": ["e2e/*.spec.ts", "e2e/surface-fixture.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "e2e/**/*.ts", "*.config.ts"]
    }
  }
}
