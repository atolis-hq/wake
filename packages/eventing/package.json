{
  "name": "@atolis-hq/eventing",
  "version": "0.1.0",
  "description": "Persistence-neutral event contracts and processor runtime for Wake",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atolis-hq/wake.git"
  },
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc --build --force tsconfig.json",
    "prepack": "npm run build",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "test": "npm run typecheck:test && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "zod": "^4.1.5"
  }
}
