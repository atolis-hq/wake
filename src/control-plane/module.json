{
  "name": "control-plane",
  "kind": "application",
  "dependencies": [
    "artifacts",
    "kernel",
    "eventing",
    "work",
    "resources",
    "activities",
    "orchestration",
    "execution"
  ],
  "publicEntry": "./index.ts",
  "namespaces": {
    "events": [
      "control-plane.trigger-invocation-started",
      "control-plane.trigger-invocation-finished",
      "control-plane.trigger-paused",
      "control-plane.trigger-request-recorded",
      "control-plane.trigger-invocation-claimed",
      "control-plane.trigger-resumed",
      "control-plane.dispatch-paused",
      "control-plane.dispatch-resumed",
      "control-plane.runner-paused",
      "control-plane.runner-resumed"
    ],
    "config": ["controlPlane"],
    "relations": [],
    "streams": ["control-plane", "control-plane-trigger", "control-plane-trigger-invocation"]
  }
}
