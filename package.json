{
  "name": "@atolis-hq/wake",
  "version": "0.1.0",
  "description": "Local autonomous agent control plane for software development",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atolis-hq/wake.git"
  },
  "type": "module",
  "workspaces": [
    "src-next/surfaces/web"
  ],
  "bin": {
    "wake": "dist/src/main.js"
  },
  "main": "./dist/src/main.js",
  "exports": "./dist/src/main.js",
  "files": [
    "dist/src",
    "dist-next/src-next/surfaces/web-assets",
    "docker",
    "prompts",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/embed-version.mjs",
    "prepack": "npm run build && npm run build:web",
    "test": "vitest run --exclude test/adapters/git-workspace-manager.test.ts --exclude test/core/tick-runner*.test.ts --exclude test/adapters/resource-index.test.ts",
    "test:legacy": "vitest run test/core/tick-runner*.test.ts test/adapters/resource-index.test.ts",
    "test:integration": "vitest run test/adapters/git-workspace-manager.test.ts",
    "test:watch": "vitest",
    "check:catalogue": "node scripts/check-functional-catalogue.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "lint:architecture": "node scripts/check-module-manifests.mjs && node scripts/check-contract-vocabulary.mjs && depcruise --config dependency-cruiser.config.mjs src-next",
    "build:next": "tsc -p tsconfig.next.json && node scripts/embed-version-next.mjs && npm run build:web",
    "build:next:docker": "tsc -p tsconfig.next.docker.json && node scripts/embed-version-next.mjs && npm run build:web",
    "build:web": "npm --workspace @atolis-hq/wake-web run build",
    "test:web": "npm --workspace @atolis-hq/wake-web run test",
    "test:web:e2e": "npm --workspace @atolis-hq/wake-web run test:e2e",
    "test:next": "npm run test:next:unit",
    "test:next:unit": "vitest run --config vitest.next.unit.config.ts",
    "test:next:architecture": "vitest run --config vitest.next.architecture.config.ts",
    "test:next:integration": "vitest run --config vitest.next.integration.config.ts",
    "test:next:e2e": "vitest run --config vitest.next.e2e.config.ts",
    "test:next:e2e:live": "vitest run --config vitest.next.live-e2e.config.ts",
    "lint:contracts": "node scripts/check-contract-vocabulary.mjs",
    "verify:next": "npm run check:catalogue && npm run lint:architecture && npm run lint:next && npm run format:check:next && npm run build:next && npm run test:web && npm run test:next:unit && npm run test:next:architecture",
    "knip:next": "knip --config knip.next.json",
    "lint": "eslint .",
    "lint:next": "eslint src-next test-next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:next": "prettier --check src-next test-next",
    "start": "tsx src/main.ts start",
    "tick": "tsx src/main.ts tick",
    "ui": "tsx src/main.ts ui",
    "e2e:github-fake": "tsx scripts/e2e-github-fake.ts",
    "smoke": "tsx src/main.ts smoke",
    "smoke:claude": "tsx src/main.ts smoke claude",
    "smoke:codex": "tsx src/main.ts smoke codex",
    "smoke:cursor": "tsx src/main.ts smoke cursor",
    "verify": "npm run lint && npm run format:check && npm run build && npm test",
    "verify:local": "npm run verify:next",
    "verify:ci": "npm run verify && npm run verify:local && npm run test:integration && npm run test:legacy && npm run test:next:integration && npm run test:next:e2e",
    "e2e:github-fake:legacy": "tsx scripts/e2e-github-fake.ts",
    "e2e:github-fake:next": "tsx scripts-next/e2e-github-fake.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "handlebars": "^4.7.9",
    "ulid": "^3.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
    "@vitest/eslint-plugin": "^1.6.24",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "knip": "^5.88.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
