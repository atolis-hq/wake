{
  "name": "@atolis-hq/wake",
  "version": "0.1.0",
  "description": "Local autonomous agent control plane for software development",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atolis-hq/wake.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "src/surfaces/web"
  ],
  "bin": {
    "wake": "dist/src/main.js"
  },
  "main": "./dist/src/main.js",
  "exports": "./dist/src/main.js",
  "files": [
    "dist/src",
    "dist/src/surfaces/web-assets",
    "docker",
    "prompts",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json && node scripts/embed-version.mjs && node scripts/check-cli-entrypoint.mjs",
    "prepack": "npm run build && npm run build:web",
    "check:workspace-packages": "node scripts/check-workspace-packages.mjs",
    "test": "npm run test:unit",
    "test:fast": "npm run test:unit",
    "check:catalogue": "node scripts/check-functional-catalogue.mjs",
    "check:scenarios": "node scripts/check-scenario-coverage.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check:specs:report": "node scripts/report-spec-drift.mjs",
    "lint:architecture": "node scripts/check-module-manifests.mjs && node scripts/check-contract-vocabulary.mjs && node scripts/check-event-architecture.mjs && depcruise --config dependency-cruiser.config.mjs src packages",
    "build:docker": "tsc --build tsconfig.docker.json && node scripts/embed-version.mjs && npm run build:web",
    "build:eventing-packages": "tsc --build packages/eventing-filesystem/tsconfig.json",
    "build:web": "npm run build:eventing-packages && npm --workspace @atolis-hq/wake-web run build",
    "test:web": "npm run build:eventing-packages && npm --workspace @atolis-hq/wake-web run test",
    "test:web:e2e": "npm --workspace @atolis-hq/wake-web run test:e2e",
    "test:unit": "npm --workspace @atolis-hq/eventing test && npm --workspace @atolis-hq/eventing-filesystem test && npm run test:unit:wake",
    "test:unit:wake": "vitest run --config vitest.unit.config.ts",
    "test:architecture": "vitest run --config vitest.architecture.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:live": "vitest run --config vitest.live-e2e.config.ts",
    "lint:contracts": "node scripts/check-contract-vocabulary.mjs",
    "knip": "knip --config knip.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:source-resolution": "tsx --tsconfig tsconfig.source.json scripts/check-workspace-source-resolution.ts",
    "start": "tsx --tsconfig tsconfig.source.json src/main.ts start",
    "tick": "tsx --tsconfig tsconfig.source.json src/main.ts tick",
    "ui": "tsx --tsconfig tsconfig.source.json src/main.ts ui",
    "e2e:github-fake": "tsx --tsconfig tsconfig.source.json scripts/e2e-github-fake.ts",
    "smoke": "tsx --tsconfig tsconfig.source.json src/main.ts smoke",
    "smoke:claude": "tsx --tsconfig tsconfig.source.json src/main.ts smoke claude",
    "smoke:codex": "tsx --tsconfig tsconfig.source.json src/main.ts smoke codex",
    "smoke:cursor": "tsx --tsconfig tsconfig.source.json src/main.ts smoke cursor",
    "verify": "npm run check:catalogue && npm run check:scenarios && npm run check:specs:report && npm run lint:architecture && npm run lint && npm run format:check && npm run check:source-resolution && npm run build && npm run test:unit",
    "verify:ci": "npm run verify && npm run test:architecture && npm run test:integration && npm run test:e2e && npm run knip && npm run test:web",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,yaml,yml,css,html}": "prettier --write"
  },
  "dependencies": {
    "@atolis-hq/eventing": "0.1.0",
    "@atolis-hq/eventing-filesystem": "0.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/secure-session": "^8.3.0",
    "@octokit/rest": "^22.0.0",
    "cron-parser": "^5.10.0",
    "fastify": "^5.12.1",
    "handlebars": "^4.7.9",
    "qrcode-terminal": "^0.12.0",
    "ulid": "^3.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/eslint-plugin": "^1.6.24",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
